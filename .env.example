OPENAI_API_KEY=pega_aqui_tu_api_key

# Opcional: si el micrófono automático no funciona en Windows,
# abre la app, lista dispositivos de audio y coloca aquí el número del micrófono.
# Ejemplo:
# WINDOWS_AUDIO_DEVICE=1
WINDOWS_AUDIO_DEVICE=

# Modelos opcionales. Puedes dejarlos así.
OPENAI_NOTE_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google OAuth para login con cuenta de Google
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501/

# Acceso inicial local. Cambiar en producción.
PJ_ADMIN_EMAIL=admin@gmail.com
PJ_ADMIN_PASSWORD=admin1234

# Envío automático de registro clínico Word al correo del profesional.
# Para Gmail se debe usar App Password, no la contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=app_password_de_gmail
SMTP_FROM=tu_correo@gmail.com
AUTO_EMAIL_ON_NOTE=true

# HL7 FHIR R4 - desactivado por defecto.
# La exportacion JSON local no requiere endpoint. El envio a HIS/RCE requiere
# validacion medica, contrato/API formal y FHIR_ENABLED=true.
FHIR_ENABLED=false
FHIR_BASE_URL=
FHIR_AUTH_MODE=none
FHIR_API_KEY=
FHIR_BEARER_TOKEN=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_TOKEN_URL=
FHIR_TIMEOUT_SECONDS=30
FHIR_VERIFY_SSL=true
FHIR_WRITE_MODE=draft
FHIR_COUNTRY_PROFILE=CL
